<section class="travel-gallery-section">
    <div class="container py-5">

        <div class="travel-gallery-header text-center">
            <span class="travel-gallery-badge">Travel Gallery</span>

            <h2>
                Travel <span>Moments</span>
            </h2>

            <p>
                Snapshots from around the world, captured by travelers like you.
                <br>
                Real places. Real experiences. Real memories.
            </p>
        </div>

        <div class="travel-gallery-grid">

            <div class="travel-gallery-item gallery-main">
                <img src="${pageContext.request.contextPath}/resources/images/packages/resort1.jpg" alt="Maldives">

                <div class="gallery-label">
                    <span>Maldives</span>
                    <small>Indian Ocean</small>
                </div>
            </div>

            <div class="travel-gallery-item gallery-wide">
                <img src="${pageContext.request.contextPath}/resources/images/packages/modern1.jpg" alt="Santorini">

                <div class="gallery-label top-label">
                    <span>Santorini, Greece</span>
                </div>
            </div>

            <div class="travel-gallery-item gallery-top-small">
                <img src="${pageContext.request.contextPath}/resources/images/packages/mountain1.jpg" alt="Banff">

                <div class="gallery-label">
                    <span>Banff, Canada</span>
                </div>
            </div>

            <div class="travel-gallery-item gallery-right-top">
                <img src="${pageContext.request.contextPath}/resources/images/packages/pool1.jpg" alt="Bali">

                <div class="gallery-label top-label">
                    <span>Bali, Indonesia</span>
                </div>
            </div>

            <div class="travel-gallery-item gallery-bottom-left">
                <img src="${pageContext.request.contextPath}/resources/images/packages/chill1.jpg" alt="Ubud">

                <div class="gallery-label">
                    <span>Ubud, Bali</span>
                </div>
            </div>

            <div class="travel-gallery-item gallery-bottom-mid">
                <img src="${pageContext.request.contextPath}/resources/images/packages/night1.jpeg" alt="Tokyo">

                <div class="gallery-label">
                    <span>Tokyo, Japan</span>
                </div>
            </div>

            <div class="travel-gallery-cta">
                <div class="gallery-cta-icon">
                    <img src="${pageContext.request.contextPath}/resources/images/packages/image-icon.png"
                         alt="Gallery Icon">
                </div>

                <h3>See more photos</h3>

                <p>
                    Explore thousands of stunning travel photos from our global community.
                </p>

                <a href="${pageContext.request.contextPath}/packages" class="gallery-cta-btn">
                    <span>Explore Gallery</span>
                    <span>&rarr;</span>
                </a>
            </div>

        </div>
    </div>
</section>