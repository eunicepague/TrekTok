<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">How Booking Works</h2>
        <p class="text-muted mb-0" style="max-width: 620px; margin: 0 auto;">
            Booking with TrekTok is simple, smooth, and designed to help travelers plan their trip with ease.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg">
            <div class="step-card h-100 text-center">
                <div class="step-number">1</div>
                <h5 class="fw-bold mb-2">Search</h5>
                <p class="text-muted mb-0">
                    Search destinations or packages based on your travel interest.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg">
            <div class="step-card h-100 text-center">
                <div class="step-number">2</div>
                <h5 class="fw-bold mb-2">Choose Package</h5>
                <p class="text-muted mb-0">
                    Browse available packages and select the one that fits your trip.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg">
            <div class="step-card h-100 text-center">
                <div class="step-number">3</div>
                <h5 class="fw-bold mb-2">Select Option</h5>
                <p class="text-muted mb-0">
                    Pick your package option, travel date, and complete the booking form.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg">
            <div class="step-card h-100 text-center">
                <div class="step-number">4</div>
                <h5 class="fw-bold mb-2">Pay Securely</h5>
                <p class="text-muted mb-0">
                    Proceed with payment to confirm your selected booking.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg">
            <div class="step-card h-100 text-center">
                <div class="step-number">5</div>
                <h5 class="fw-bold mb-2">Leave Feedback</h5>
                <p class="text-muted mb-0">
                    After your trip, share your experience to help other travelers.
                </p>
            </div>
        </div>
    </div>
</div>