<div class="container py-5">
    <div class="mb-4">
        <h2 class="fw-bold">Featured Tour Packages</h2>
        <p class="text-muted mb-0" style="max-width: 520px;">
            Plan, book, and embark on your dream adventure with our expert guidance and tailored experiences.
        </p>
    </div>

    <div class="row g-4">
        <!-- Card 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="position-relative">
                    <img src="${pageContext.request.contextPath}/resources/images/packages/baguio.jpg"
                         class="card-img-top"
                         style="height: 220px; object-fit: cover;"
                         alt="Baguio Tour">
                    <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill">
                        Popular
                    </span>
                </div>
                <div class="card-body">
                    <h5 class="card-title fw-bold">Baguio Tour</h5>
                    <p class="text-muted mb-2">Baguio City, Benguet</p>
                    <p class="card-text">3 days and 2 nights Baguio package perfect for quick relaxing getaways.</p>
                    <p class="mb-2"><strong>From ₱3,500</strong></p>
                    <p class="text-muted small mb-3">Available Slots: 10</p>
                    <a href="${pageContext.request.contextPath}/book?packageId=1" class="btn btn-primary rounded-pill px-4">
                        Book Now
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="position-relative">
                    <img src="${pageContext.request.contextPath}/resources/images/packages/palawan.jpg"
                         class="card-img-top"
                         style="height: 220px; object-fit: cover;"
                         alt="Palawan Tour">
                    <span class="badge bg-success position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill">
                        Best Seller
                    </span>
                </div>
                <div class="card-body">
                    <h5 class="card-title fw-bold">Palawan Tour</h5>
                    <p class="text-muted mb-2">Palawan</p>
                    <p class="card-text">4 days and 3 nights Palawan getaway with scenic island views and beach adventures.</p>
                    <p class="mb-2"><strong>From ₱8,500</strong></p>
                    <p class="text-muted small mb-3">Available Slots: 24</p>
                    <a href="${pageContext.request.contextPath}/book?packageId=2" class="btn btn-primary rounded-pill px-4">
                        Book Now
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="position-relative">
                    <img src="${pageContext.request.contextPath}/resources/images/packages/cebu.jpg"
                         class="card-img-top"
                         style="height: 220px; object-fit: cover;"
                         alt="Cebu Tour">
                    <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill">
                        Limited Slots
                    </span>
                </div>
                <div class="card-body">
                    <h5 class="card-title fw-bold">Cebu Tour</h5>
                    <p class="text-muted mb-2">Cebu</p>
                    <p class="card-text">3 days and 2 nights Cebu package with city highlights and island experience.</p>
                    <p class="mb-2"><strong>From ₱5,000</strong></p>
                    <p class="text-muted small mb-3">Available Slots: 19</p>
                    <a href="${pageContext.request.contextPath}/book?packageId=3" class="btn btn-primary rounded-pill px-4">
                        Book Now
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>